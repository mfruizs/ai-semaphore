{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" green",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" yellow",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" yellow",
        "timeoutSec": 5
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" red",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" yellow",
        "timeoutSec": 5
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" yellow",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" green",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" green",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/ai-semaphore-hook.sh\" green",
        "timeoutSec": 5
      }
    ]
  }
}
